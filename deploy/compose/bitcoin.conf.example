# Generated by `just local-setup` — copied here as a shape reference.
# Never commit the real bitcoin.conf; it holds per-machine credentials.
signet=1
signetchallenge=<66-byte compressed pubkey hex generated by local-setup>
txindex=1
server=1
fallbackfee=0.00001
maxconnections=16

[signet]
rpcuser=signet
rpcpassword=<random hex generated by local-setup>
rpcbind=0.0.0.0
rpcallowip=0.0.0.0/0
