ARG ELECTRS_VERSION=v0.11.1

FROM debian:trixie-slim AS base
RUN apt-get update -qqy
RUN apt-get install -qqy librocksdb-dev curl

FROM base AS electrs-build
ARG ELECTRS_VERSION
# System librocksdb (trixie: 9.x) only matches electrs >= 0.11. Older tags
# lock an electrs-rocksdb fork that expects the 6.x C API and must compile
# the vendored rocksdb source instead.
ARG SYSTEM_ROCKSDB=1
RUN apt-get install -qqy cargo build-essential libclang-dev clang git ca-certificates
WORKDIR /build
RUN git clone --branch ${ELECTRS_VERSION} --depth 1 https://github.com/romanz/electrs
RUN if [ "${SYSTEM_ROCKSDB}" = "1" ]; then \
        export ROCKSDB_INCLUDE_DIR=/usr/include ROCKSDB_LIB_DIR=/usr/lib; \
    fi; \
    cargo install --locked --path electrs

FROM base AS result
COPY --from=electrs-build /root/.cargo/bin/electrs /usr/bin/electrs
WORKDIR /
