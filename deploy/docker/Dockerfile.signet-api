FROM node:24-slim AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM rust:1.98-slim AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml versions.toml ./
COPY crates ./crates
COPY --from=ui /ui/dist ./ui/dist
RUN cargo build --release -p signet-api

FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/signet-api /usr/local/bin/signet-api
ENTRYPOINT ["signet-api"]
