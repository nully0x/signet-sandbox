meta {
  name: environment.create (lightning)
  type: http
  seq: 10
}

post {
  url: {{rpc_url}}
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{bearer}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "environment.create",
    "params": {
      "name": "ln-env",
      "components": {
        "indexer": true,
        "faucet": true,
        "lightning": [
          { "name": "ln-alice", "implementation": "lnd" },
          { "name": "ln-bob", "implementation": "lnd" }
        ]
      }
    }
  }
}

script:post-response {
  const envId = res.body?.result?.environment_id;
  if (envId) {
    bru.setEnvVar("env_id", envId);
    console.log("env_id captured:", envId);
  }
}
