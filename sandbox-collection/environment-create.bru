meta {
  name: environment.create
  type: http
  seq: 2
}

post {
  url: {{rpc_url}}
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{bearer}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "environment.create",
    "params": {
      "name": "bruno-env",
      "components": { "indexer": true, "explorer": true, "faucet": true }
    }
  }
}

script:post-response {
  const envId = res.body?.result?.environment_id;
  if (envId) {
    bru.setEnvVar("env_id", envId);
    console.log("env_id captured:", envId);
  }
}
