# Signet Sandbox — dev environment template.
#
# `just local-setup` generates .env with real values; this file documents
# every variable. Keep it in sync with scripts/local-setup.sh.
#
# First-run sequence — each step needs the previous one:
#   1. just local-setup      # writes .env + deploy/compose/bitcoin.conf (once)
#   2. just dev-up           # bitcoind + postgres containers
#   3. just dev-api          # provisioning API on :8081 — keep it running
#   4. just get-token        # mints a bearer token from SIGNET_DEV_NSEC
#
# `just get-token` talks to the API, so step 3 must be up first or it
# fails with "cannot reach the API".

# --- chain (generated; `local-setup --force` regenerates and invalidates the chain) ---

# Commitment for the custom signet genesis/proof-of-work
SIGNET_CHALLENGE=5121...

# Per-env signer identity (dev chain key pair)
SIGNER_KEY_WIF=...
SIGNER_PUBKEY=...

# Stable dev Nostr key (64-hex). Defines the dev identity: every token
# minted via `just get-token` owns the dev environments. Generate once:
#   openssl rand -hex 32
SIGNET_DEV_NSEC=...

# Block cadence and premine for the dev signer
SIGNER_INTERVAL_SECS=30
SIGNER_PREMINE_BLOCKS=101
SIGNER_WALLET=faucet

# --- bitcoind RPC (compose stack) ---

BITCOIN_RPC_URL=http://localhost:38332
BITCOIN_RPC_USER=signet
BITCOIN_RPC_PASSWORD=<openssl rand -hex 16>

# --- postgres (compose stack + API) ---

# Keep in sync with the port inside DATABASE_URL below.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=signet
POSTGRES_DB=signet
POSTGRES_PASSWORD=<openssl rand -hex 16>
DATABASE_URL=postgres://signet:<password>@localhost:5432/signet

# --- provisioning API (optional; defaults shown) ---

SIGNET_API_LISTEN=0.0.0.0:8081
SIGNET_API_PUBLIC_URL=http://localhost:8081
SIGNET_ENV_HOST=http://localhost
# Reaper pass interval; 0 disables TTL reaping
SIGNET_REAPER_INTERVAL_SECS=60
# NIP-98 acceptance window; 0 disables expiry — local dev only
SIGNET_NIP98_MAX_AGE_SECS=300

# --- CLI (optional; defaults shown) ---

SIGNET_API=http://localhost:8081
# Per-shell credential; or: export SIGNET_TOKEN=$(just get-token)
# SIGNET_TOKEN=sgn_...
